<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="16dp" android:background="#0B0D10"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
            <TextView android:text="Mazkiplay Agent" android:textColor="#FFFFFF" android:textSize="25sp" android:textStyle="bold"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/modelLabel" android:text="Private AI workspace" android:textColor="#9AA4B2" android:textSize="13sp"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
        <Button android:id="@+id/settings" android:text="⚙" android:minWidth="48dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <TextView android:id="@+id/status" android:text="● Ready" android:textColor="#62E6A5" android:textSize="12sp"
        android:paddingTop="8dp" android:paddingBottom="6dp"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
        <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <Button android:id="@+id/quickPlan" android:text="Plan" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <Button android:id="@+id/quickJob" android:text="Job CV" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <Button android:id="@+id/quickIdeas" android:text="Ideas" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <Button android:id="@+id/quickTranslate" android:text="Translate" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
    </HorizontalScrollView>

    <ScrollView android:id="@+id/scroll" android:fillViewport="true"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <TextView android:id="@+id/chat" android:text="Welcome. Add your OpenRouter key in Settings, then ask me anything."
            android:textColor="#E7ECF3" android:textSize="16sp" android:lineSpacingExtra="5dp"
            android:padding="14dp" android:background="#141820"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </ScrollView>

    <EditText android:id="@+id/input" android:hint="Ask Mazkiplay Agent…"
        android:textColor="#FFFFFF" android:textColorHint="#727C8A" android:backgroundTint="#596579"
        android:inputType="textCapSentences|textMultiLine" android:imeOptions="actionSend"
        android:minLines="2" android:maxLines="5" android:gravity="top|start"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/clear" android:text="Clear" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <Space android:layout_width="8dp" android:layout_height="1dp"/>
        <Button android:id="@+id/send" android:text="Send" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>